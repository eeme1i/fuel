{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:migrate": "wrangler d1 migrations apply fuel --local",
    "db:migrate:remote": "wrangler d1 migrations apply fuel --remote",
    "sync": "node scripts/sync.mjs",
    "sync:remote": "node scripts/sync.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.110.0"
  }
}
